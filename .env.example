# ── Firebase Client (público — prefijo VITE_ expuesto en el bundle) ──────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=caresignal-mvp-2026.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caresignal-mvp-2026
VITE_FIREBASE_APP_ID=

# URL del backend en Cloud Run
VITE_CLOUD_RUN_URL=https://caresignal-api-xxxx-uc.a.run.app

# ── Backend / Cloud Run (secretos — solo en GCP Secret Manager) ──────────────
FIREBASE_PROJECT_ID=caresignal-mvp-2026
# GOOGLE_APPLICATION_CREDENTIALS se inyecta automáticamente en Cloud Run
# con la cuenta de servicio del contenedor; no hace falta en .env de producción.

# Dominio de Google Workspace autorizado para SSO
ALLOWED_DOMAIN=residencia.com

PORT=8080

# ── Modo de acceso (B-06) ─────────────────────────────────────────────────────
# guest  = solo perfiles de demo (sin cuenta)  · hybrid = perfiles + Google  · google = solo Google
# Si se omite: google cuando hay VITE_FIREBASE_API_KEY, guest en caso contrario.
VITE_ACCESS_MODE=
# picker (default) = elegir perfil · auto = entrar directo con el primer perfil (suite E2E)
VITE_GUEST_ENTRY=

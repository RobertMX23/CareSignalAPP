{
  "name": "CareSignal Dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "forwardPorts": [5173, 4000, 8080],
  "portsAttributes": {
    "5173": { "label": "Vite dev server",       "onAutoForward": "openBrowser" },
    "4000": { "label": "Firebase Emulator UI",  "onAutoForward": "notify" },
    "8080": { "label": "Cloud Run / API local", "onAutoForward": "notify" }
  },

  "postCreateCommand": "npm install && npx playwright install --with-deps chromium",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "eamodio.gitlens",
        "github.vscode-pull-request-github",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}

{
  "name": "CareSignal Dev",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {
      "version": "latest",
      "installDefaultComponents": false
    }
  },

  "forwardPorts": [5173, 4000, 4400, 5001, 8080, 9099, 9199],
  "portsAttributes": {
    "5173": { "label": "Vite dev server",         "onAutoForward": "openBrowser" },
    "4000": { "label": "Firebase Emulator UI",    "onAutoForward": "notify" },
    "4400": { "label": "Firebase Auth Emulator",  "onAutoForward": "silent" },
    "5001": { "label": "Firebase Functions",      "onAutoForward": "silent" },
    "8080": { "label": "Cloud Run / API local",   "onAutoForward": "notify" },
    "9099": { "label": "Firestore Emulator",      "onAutoForward": "silent" },
    "9199": { "label": "Firebase Storage",        "onAutoForward": "silent" }
  },

  "postCreateCommand": "npm install && npm install -g firebase-tools",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "vitest.explorer",
        "bradlc.vscode-tailwindcss",
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "Firebase.vscode-firebase",
        "GoogleCloudTools.cloudcode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "vitest.enable": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteEnv": {
    "NODE_ENV": "development"
  }
}

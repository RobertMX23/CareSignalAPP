{
  "name": "caresignal-mvp",
  "version": "0.1.0-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:functions": "npm --prefix functions run build && npx --yes firebase-tools@15 emulators:exec --only auth,functions,firestore --project demo-caresignal-functions \"npm --prefix functions run test:emulator\"",
    "test:rules": "npx --yes firebase-tools@13 emulators:exec --only firestore --project demo-caresignal-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "docs:dossier": "node tools/build-dossier.cjs",
    "docs:deck": "node tools/build-deck.cjs",
    "docs:lamina": "node tools/build-lamina.cjs",
    "docs:all": "npm run docs:dossier && npm run docs:deck && npm run docs:lamina",
    "provision:firestore": "ts-node --project scripts/tsconfig.json scripts/provision-firestore.ts"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "docx": "^9.9.0",
    "jsdom": "^30.1.2",
    "pptxgenjs": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
